rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All business-data reads/writes go through Firebase Cloud Functions.
    // This keeps tenant isolation and role checks in one trusted layer.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /organizations/{orgId} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/{collection}/{docId} {
      allow read, write: if false;
    }

    match /password_reset_requests/{requestId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
