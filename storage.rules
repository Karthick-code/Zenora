rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage is currently used only by authenticated Zenora users. Files should
    // be stored under a company-owned path such as organizations/{orgId}/... .
    match /organizations/{orgId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organization_id == orgId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
